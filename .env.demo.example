# ==============================================================================
# CONFIGURATION DU MODE DÉMO MARMICOUT (POUR VITRINE APPALACARTE)
# ==============================================================================
# Ces variables sont strictement réservées au mode démo.
# L'application de production existante n'en dépend pas.
# ==============================================================================

# Activer le mode démo
VITE_DEMO_MODE=true

# URL de redirection vers votre vitrine Appalacarte
VITE_APPALACARTE_URL=https://appalacarte.fr

# Identifiants Supabase dédiés au mode démo (Optionnel - la démo fonctionne en local/autonome par défaut)
VITE_DEMO_SUPABASE_URL=https://votre-projet-demo.supabase.co
VITE_DEMO_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
